{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.secret)",
      "Read(secrets/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git reset *--hard*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(find * -delete*)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *)"
    ],
    "ask": [
      "Edit(/.claude/tools/check-docs.py)",
      "Edit(/.claude/settings.json)",
      "Edit(/.gitattributes)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git restore *)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "PowerShell(git tag *)",
      "PowerShell(git rebase *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout * -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout -f*)",
      "PowerShell(git restore *)",
      "PowerShell(git switch -f*)",
      "PowerShell(git switch --discard-changes*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git branch -D *)"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-instructions.py",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          },
          {
            "type": "command",
            "if": "Bash(git * commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          },
          {
            "type": "command",
            "if": "PowerShell(git * commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Reading the project's state..."
          }
        ]
      }
    ]
  }
}
