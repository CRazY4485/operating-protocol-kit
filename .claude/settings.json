{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.secret)",
      "Read(secrets/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -d *)",
      "Bash(rm *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push -f *)",
      "PowerShell(git clean -f *)",
      "PowerShell(git clean -fd *)",
      "PowerShell(git clean -d *)",
      "PowerShell(Remove-Item *)"
    ],
    "ask": [
      "Edit(/.claude/tools/check-docs.py)",
      "Edit(/.claude/settings.json)",
      "Edit(/.gitattributes)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "PowerShell(git tag *)",
      "PowerShell(git rebase *)",
      "PowerShell(git filter-branch *)"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-instructions.py",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/check-docs.py",
              "--root",
              "${CLAUDE_PROJECT_DIR}",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "Running the document gate before commit..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py"
            ],
            "timeout": 20,
            "statusMessage": "Reading the project's state..."
          }
        ]
      }
    ]
  }
}
